/*
 * Tempest Dux shared configuration (both halves).
 *
 * All pins verified against the v0.6.56 KiCad netlist (MCU1 pads 101-124):
 *   rows:  pro_micro 4/5/6/7   = row_top / row_home / row_bottom / row_thumb
 *   cols:  pro_micro 20/19/18/15/14 = col_pinky / ring / middle / index / inner
 *   PMW3610: SCLK P1.06 (pm9), SDIO P1.04 (pm8, 3-wire), nCS P0.09 (pm10),
 *            MOTION P0.31 (pm21, R1 pull-up DNP -> internal pull-up)
 *   display: stock nice_view_adapter pins (CS P0.06, MOSI P0.17, SCK P0.20)
 *
 * The ceoloide reversible MCU footprint cross-connects on B.Cu, so the same
 * pro_micro numbers carry the matrix and trackball on both halves.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    default_layout: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        // Emits minidox.h order: 3x10 alphas, then thumbs L near->far, R far->near.
        // Right half is the mirrored reversible board, so its row entries run 9->5.
        // VERIFY on hardware: if a left thumb fires the wrong miryoku thumb,
        // reverse the three RC(3,x) left entries and mirror the right.
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                RC(3,2) RC(3,3) RC(3,4)    RC(3,9) RC(3,8) RC(3,7)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        // col2row: rows are sensed inputs, cols are strobed outputs
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row_top
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row_home
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row_bottom
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row_thumb
            ;

        col-gpios
            = <&pro_micro 20 GPIO_ACTIVE_HIGH>   // col_pinky   (col 0)
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   // col_ring    (col 1)
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   // col_middle  (col 2)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   // col_index   (col 3)
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   // col_inner   (col 4)
            ;
    };

    // Local trackball -> pointer events. Enabled per-half in the overlays.
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    // Forwarding channel for the peripheral half's trackball.
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    // Central-side listener for events arriving over the split link.
    trackball_split_listener: trackball_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};

// PMW3610 on its own SPI bus (spi1) so it never collides with the
// display on spi0/pro_micro_spi (left half).
&pinctrl {
    spi1_trackball_default: spi1_trackball_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 6)>,   // PMW_SCLK  P1.06 / pm9
                    <NRF_PSEL(SPIM_MOSI, 1, 4)>,   // PMW_SDIO  P1.04 / pm8
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;   // same pin: 3-wire SDIO
        };
    };

    spi1_trackball_sleep: spi1_trackball_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 4)>,
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_trackball_default>;
    pinctrl-1 = <&spi1_trackball_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&pro_micro 10 GPIO_ACTIVE_LOW>;   // PMW_CS / P0.09

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        // MOTION is active-low; on-board R1 pull-up is DNP -> internal pull-up
        irq-gpios = <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        // VERIFY orientation on first roll; flip as needed:
        // swap-xy; invert-x; invert-y;
    };
};
